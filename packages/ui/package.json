{
  "name": "@better-tracker/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic React components for the task UI in Gr8r Studio's layout and look (warm neutral surfaces, soft borders, tinted status colours, Geist). Consumed as source by the planner (Next.js) and portable to Vite apps such as Dispatch.",
  "files": [
    "src",
    "global.d.ts",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./*": "./src/*"
  },
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
