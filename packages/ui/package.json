{
  "name": "@better-tracker/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic React components for the task UI: Gr8r Studio layout in the Analytics visual language. Consumed as source by the planner (Next.js) and portable to Vite apps such as Dispatch.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./*": "./src/*"
  },
  "dependencies": {
    "@dagrejs/dagre": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
