{
  "name": "@better-tracker/store",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres persistence (pg in production, PGlite for local dev and tests) for tool-owned data and the Linear mirror.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@better-tracker/core": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
