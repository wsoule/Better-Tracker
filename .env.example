# Milestone Planner: every environment variable the web app (apps/planner),
# the worker (apps/worker) and the engine read. See docs/architecture.md §10
# and docs/deploy.md. Placeholders only: never commit real values.
#
# Local use: copy to apps/planner/.env.local (Next.js reads env files from the
# app directory; *.local is gitignored) and run the worker from the repo root
# with the same file:
#   node --env-file=apps/planner/.env.local apps/worker/dist/index.js tick
# Set DATABASE_URL then: a relative PGLITE_DIR resolves against each process's
# working directory (the web app runs in apps/planner, the worker in the repo
# root), so without it the web app and the worker would use two different
# databases.
# On Railway, set these as service variables instead (docs/deploy.md, step 3).
#
# Blank values count as unset. OAuth mode (the default: LINEAR_FIXTURE and
# LINEAR_AUTH unset) refuses to start without APP_URL, TOKEN_ENCRYPTION_KEY,
# LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET, and lists every missing or invalid
# variable at once.

# --- Demo mode ---------------------------------------------------------------
# 1 = run against a fictional in-memory workspace: no Linear, no Slack, no
# Postgres (DATABASE_URL is ignored). Nothing else is required. Never set it in
# production.
# showcase = the same, on the large showcase workspace made for the live demo
# (about 400 issues and 250 blocking relations; docs/architecture.md §4).
# LINEAR_FIXTURE=1

# --- How the planner reaches Linear (docs/architecture.md §7.4) --------------
# oauth (default) = the Linear OAuth app below. api_key = each person pastes
# their own personal Linear API key on the home page; the planner keeps it only
# in its memory (never in the database, on disk, in logs or the browser), so
# TOKEN_ENCRYPTION_KEY, SESSION_SECRET, LINEAR_CLIENT_*, LINEAR_WEBHOOK_SECRET,
# SLACK_BOT_TOKEN and SESSION_DAYS are not read. Nothing runs on a schedule in
# api_key mode. Set it once, shared by the web app and the worker. Never
# together with LINEAR_FIXTURE. docs/deploy.md section 7.
# LINEAR_AUTH=oauth
# api_key mode: the Linear workspace URL key (linear.app/<key>) or organization
# id the planner serves. Required when deployed (NODE_ENV=production on a
# non-loopback APP_URL, which must then be https); unset locally, the first
# workspace member to connect binds it.
# LINEAR_WORKSPACE=
# TESTS ONLY (api_key and OAuth mode): the GraphQL endpoint of a local fake
# Linear on 127.0.0.1 or [::1], accepted only with a loopback APP_URL; in
# OAuth mode its origin also answers for Linear's token, revoke and authorize
# pages. Never set it anywhere else.
# LINEAR_API_URL=
# api_key mode when deployed: must include --disable-sigusr1 (deploy/Dockerfile
# sets it); inspector and heap-snapshot flags are refused in api_key mode.
# NODE_OPTIONS=--disable-sigusr1

# --- App ---------------------------------------------------------------------
# Public base URL, no trailing slash. Used for the OAuth callback
# (<APP_URL>/api/auth/linear/callback) and for links in digests.
# Default in demo mode: http://localhost:3000.
APP_URL=
# Display name in Linear comments, digests and the UI.
# APP_NAME=Milestone Planner
# debug | info | warn | error (default info). Logs are JSON lines.
# LOG_LEVEL=info
# How many workspaces' indexed mirrors one process keeps in memory, least
# recently read dropped first (default 16, 1-64). Matters for the web app when
# it serves several workspaces; the worker exits after each tick.
# MIRROR_CACHE_WORKSPACES=16

# --- Database ----------------------------------------------------------------
# Postgres connection string. On Railway: ${{Postgres.DATABASE_URL}} (private
# network, no SSL settings needed).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/planner
# Without DATABASE_URL, PGlite (embedded Postgres) stores data in this
# directory (default .data/pglite; in demo mode, in memory unless set). Local
# development only: two processes must never share one directory.
# PGLITE_DIR=.data/pglite
# Optional libpq startup options (`-c name=value ...`) for Postgres
# connections. The store keeps them and appends its own
# `-c default_transaction_isolation=read committed`, which wins.
# PGOPTIONS=

# --- Secrets (OAuth mode only) ----------------------------------------------
# 32 random bytes, base64, used to encrypt stored Linear tokens. Generate with
#   openssl rand -base64 32
# The web app and the worker must use the same key. Changing it makes stored
# tokens unreadable (everyone signs in again; an admin reinstalls).
TOKEN_ENCRYPTION_KEY=
# At least 32 characters; signs the short-lived OAuth cookie (web app).
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Session lifetime in days, 1-365 (default 30).
# SESSION_DAYS=30

# --- Linear OAuth application (OAuth mode only; docs/deploy.md, step 1) -------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# The OAuth app's webhook signing secret (web app; verifies Linear-Signature).
LINEAR_WEBHOOK_SECRET=

# --- Slack (docs/deploy.md, step 2) ------------------------------------------
# Bot User OAuth Token (xoxb-...) with chat:write, users:read and
# users:read.email. Without it, digests stay in the outbox and nothing is sent.
# One bot is never used while this planner may serve more than one workspace
# (LINEAR_WORKSPACES=*, a list of several, or unset with several installed):
# digests then stay in each workspace's outbox and boot logs a warning.
SLACK_BOT_TOKEN=

# --- Which workspaces may use this planner (OAuth mode; docs/deploy.md) -------
# Comma-separated Linear organization ids (recommended: Settings -> Status,
# /setup and the worker's `workspaces` command show them) or URL keys, at most
# 100; or exactly * for every Linear workspace (boot logs a warning). Unset:
# closed to new workspaces, only those already installed may sign in. Set the
# same value on the web app AND the worker (a Railway shared variable).
# LINEAR_WORKSPACES=

# --- Public pages (/privacy, /terms, /contact; the landing page) --------------
# Who runs this planner, shown on /contact and the landing page, and named in
# the privacy and terms pages. All optional; without them the pages say so
# neutrally (a deployed OAuth planner without OPERATOR_EMAIL logs one info
# line). OPERATOR_URL and DEMO_URL must be http(s) URLs.
# OPERATOR_NAME=
# OPERATOR_EMAIL=
# OPERATOR_URL=
# A public demo of the planner, linked from the landing page as "Try the demo
# first".
# DEMO_URL=

# --- Workspace defaults -------------------------------------------------------
# IANA timezone for workspaces with no saved setting (default UTC). Drives
# "today", days left and when the daily job is due.
DEFAULT_TIMEZONE=UTC
# Comma-separated emails of the first watchers (warned about every at-risk
# milestone, besides its project's lead), saved on the first full sync after
# the install; if none match, the installer becomes the first watcher. There
# is no PM role: everyone signed in can edit everything, so PM_EMAILS is no
# longer read (a deploy that still sets it logs one warning). Example:
# wyat@example.com,shanzer@example.com
WATCHER_EMAILS=

# --- Worker scheduler ---------------------------------------------------------
# When the daily job (sync, allocation, warnings) becomes due, HH:MM 00:00-23:59
# in each workspace's timezone (default 08:00). Keep it at 23:45 or earlier
# with the 15-minute cron.
# DAILY_RUN_AT=08:00
# A worker run (tick, or a manual sync, daily, allocate or warn; not migrate)
# that is still going this many minutes after the process started (boot and
# closing the store included) logs an error and exits 1, so a hung run never
# blocks later cron runs. serve applies it to each tick. Default 10, at most
# 14: below the 15-minute cron interval, and short enough that a daily job a
# dead run held is taken over safely after the engine's 45-minute lease.
# TICK_TIMEOUT_MINUTES=10
# `serve` only (a long-running alternative to cron): minutes between ticks
# (default 15, 1-1440). In api_key mode: minutes between the web app's own
# syncs while a workspace member is connected (default 15, 1-1440).
# SYNC_INTERVAL_MINUTES=15
# How many workspaces one run (tick, or sync, daily, allocate or warn over every
# workspace) works on at once, least recently synced first (default 3, 1-8).
# Each workspace in flight uses at most one of the process's 10 Postgres
# connections at a time; 8 leaves room for the rest of the run.
# WORKER_CONCURRENCY=3

# --- Hosting -------------------------------------------------------------------
# Port the web app listens on (the Docker image defaults to 3000). Set it
# explicitly on Railway.
# PORT=3000
# Railway build setting for both services (read by Railway, not by the app):
# RAILWAY_DOCKERFILE_PATH=deploy/Dockerfile

# --- Tests ----------------------------------------------------------------------
# Optional: run packages/store's Postgres suites against a real database.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/planner_test
# Optional: a transaction-mode PgBouncer (default configuration) in front of
# Postgres; runs packages/store's suite behind a pooler.
# TEST_PGBOUNCER_URL=postgres://postgres@127.0.0.1:6432/planner_test
# Planner browser smoke (planner:test-e2e): the port of its `next start`
# (default 3390 plus the worktree offset) and a Chromium to use instead of
# Playwright's own download.
# E2E_PORT=3390
# PLAYWRIGHT_CHROMIUM_PATH=
